# =============================================================================
# DEFAULT ENVIRONMENT VARIABLES (NON-SECRET)
# =============================================================================
# These values are safe to commit to version control
# Copy these to .env and modify as needed, or set them in Portainer
# =============================================================================

# User/Group Configuration
PUID=1026
PGID=100

# Timezone
TZ=America/New_York

# Directory Configuration
DOCKERDIR=/volume1/docker
USERDIR=/volume1/data

# Port Mappings (based on current running containers)
# Gluetun Ports
GLUETUN_PORT1=9019    # HTTP proxy
GLUETUN_PORT2=9020    # Shadowsocks TCP
GLUETUN_PORT3=9021    # Shadowsocks UDP

# Deluge Ports (via Gluetun)
DELUGE_PORT1=9012     # Web UI
DELUGE_PORT2=9013     # Torrents

# Other Service Ports
FIREFOX_PORT=9004     # Browser
SABNZBD_PORT=9003     # SABnzbd Web UI
KOMGA_PORT=9005       # Komga Web UI
SONARR_PORT=9002      # Sonarr Web UI
RADARR_PORT=9001      # Radarr Web UI
PROWLARR_PORT=9016    # Prowlarr Web UI
XTEVE_PORT1=9009      # xTeVe main port
XTEVE_PORT2=9010      # xTeVe secondary port
LAZYLIBRARIAN_PORT=9017  # LazyLibrarian Web UI

# VPN Configuration (non-secret)
VPNSP=private internet access
VPN_SERVICE_PROVIDER=pia
VPN_TYPE=openvpn
REGION=US East Streaming Optimized

# Application Configuration
DELUGE_LOGLEVEL=error
XTEVE_DEBUG=0
XTEVE_API=1

# Container Names (if using variables)
GLUETUN_CONTAINER=gluetun
DELUGE_CONTAINER=deluge
SABNZBD_CONTAINER=sabnzbd
KOMGA_CONTAINER=gotson-komga-1
PLEX_CONTAINER=plex
SONARR_CONTAINER=sonarr
RADARR_CONTAINER=radarr
PROWLARR_CONTAINER=prowlarr
XTEVE_CONTAINER=xteveGuide2Go
LAZYLIBRARIAN_CONTAINER=lazylibrarian

# Network Configuration
COMPOSE_PROJECT_NAME=mediaplex
DEFAULT_NETWORK=mediaplex_default

# =============================================================================
# SECRETS (stored in Portainer environment variables/secrets)
# =============================================================================
# The following variables contain secrets and should be set in Portainer:
# - PIA_USERNAME          # Private Internet Access username
# - PIA_PASSWORD          # Private Internet Access password  
# - PLEX_CLAIM            # Plex claim token for server setup
# - SERVER_IP             # Server IP address for Plex advertising
# =============================================================================
